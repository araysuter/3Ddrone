# Absolute path on the Ubuntu host. Do not place this inside the Git checkout.
MAPPER_DATA_DIR=/srv/local-aerial-mapper

# Generate both with: openssl rand -hex 32
NODEODM_TOKEN=replace-with-a-long-random-token
MAPPER_INTERNAL_TOKEN=replace-with-a-different-long-random-token

# Keep true when using Tailscale Serve HTTPS. Set false only for direct HTTP development.
MAPPER_COOKIE_SECURE=true
MAPPER_SESSION_HOURS=24
