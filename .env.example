# Absolute path on the Ubuntu host. Do not place this inside the Git checkout.
MAPPER_DATA_DIR=/srv/local-aerial-mapper

# Generate both with: openssl rand -hex 32
NODEODM_TOKEN=replace-with-a-long-random-token
MAPPER_INTERNAL_TOKEN=replace-with-a-different-long-random-token

# Match the Ubuntu account that owns MAPPER_DATA_DIR (`id -u` and `id -g`).
# The common first-user values are 1000/1000.
MAPPER_UID=1000
MAPPER_GID=1000

# Keep true when using Tailscale Serve HTTPS. Set false only for direct HTTP development.
MAPPER_COOKIE_SECURE=true
MAPPER_SESSION_HOURS=24

# Keep this much disk free while accepting uploads and extracting results.
# The default is 5 GiB. Lower it only for a disposable development/demo host.
MAPPER_DISK_RESERVE_BYTES=5368709120

# Optional public, read-only sharing. The operator UI remains available only
# through the loopback/Tailscale path even when this profile is enabled.
MAPPER_SHARING_ENABLED=false
MAPPER_PUBLIC_BASE_URL=https://dronemaps.ashersuter.com

# Before enabling sharing, generate this independently with:
# openssl rand -hex 32
MAPPER_SHARE_SIGNING_KEY=replace-with-a-third-long-random-token

# Create a remotely managed Cloudflare Tunnel and paste only its connector
# token here. Never commit a real token.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Set to sharing after the values above are configured.
COMPOSE_PROFILES=
